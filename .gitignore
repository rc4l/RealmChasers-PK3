# macOS
.DS_Store

# Unity meta files (shouldn't be in PK3)
*.meta

# Backup files
*.backup
*.backup[0-9]
*.backup[0-9][0-9]
*~
*.bak

# Autosave files
*.autosave
*.autosave[0-9]
*.autosave[0-9][0-9]

# Doom Builder files
*.dbs

# Log files and folders
*.log
logdump/
# --- Unity project scaffolding ---
# This repo is an asset/source repo (maps/, sprites/, in/, out/, deps/), NOT a Unity
# project. If a Unity editor is ever pointed at this folder it scaffolds a full project
# here; ignore all of it so it never gets tracked and download_pk3.sh's clean-repo check
# doesn't trip on it.
/Assets/
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/Packages/
/ProjectSettings/
/.vscode/
/.idea/
*.sln
*.csproj
*.unityproj
